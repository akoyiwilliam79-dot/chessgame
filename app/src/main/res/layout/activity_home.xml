<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp">

        <!-- BRAND HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="#1D2B43"
                android:gravity="center"
                android:text="♞"
                android:textColor="#F8B82E"
                android:textSize="48sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHESSMASTER"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="THINK AHEAD. PLAY SMART."
                    android:textColor="#F8B82E"
                    android:textSize="10sp"
                    android:letterSpacing="0.08" />

            </LinearLayout>
        </LinearLayout>

        <!-- WELCOME SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WELCOME, CHAMPION"
                android:textColor="#8D9AB0"
                android:textSize="14sp"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Every move tells\na story."
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Think strategically. Play fearlessly. Become a master."
                android:textColor="#AAB5C8"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- FEATURED PLAY CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1B2A43"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="♜      ♞      ♝      ♛      ♚"
                android:textColor="#F8B82E"
                android:textSize="34sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="THE BATTLE BEGINS"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enter the 3D chess arena and put your strategy to the test."
                android:textColor="#B9C5D8"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/btnPlayNow"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#F8B82E"
                android:text="PLAY NOW    →"
                android:textAllCaps="false"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- EXPERIENCE OPTIONS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="CHOOSE YOUR EXPERIENCE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <Button
            android:id="@+id/btnQuickMatch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#30435F"
            android:text="♟   QUICK MATCH  ·  LOCAL 1V1"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnTraining"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#30435F"
            android:text="♞   TRAINING &amp; GAME MODES"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- SECONDARY OPTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStatistics"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#202E46"
                android:text="STATISTICS"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#202E46"
                android:text="SETTINGS"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="CHESSMASTER  ·  PLAY WITH PURPOSE"
            android:textColor="#59667D"
            android:textSize="12sp"
            android:letterSpacing="0.05" />

    </LinearLayout>

</ScrollView>

